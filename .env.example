# ─────────────────────────────────────────────────────────────────────────────
# Leonida Records — environment variables
# Copy this file to .env.local (local) and add the same values in Vercel
# (Project → Settings → Environment Variables). NEVER commit real keys.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase → Project Settings → API (Data API) → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase → Project Settings → API Keys → "Publishable key" (sb_publishable_...)
# Safe to expose: every request is still limited by Row Level Security.
# (Older projects: the legacy "anon" key also works here.)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Public URL of the site, WITHOUT trailing slash. Used for canonical URLs,
# sitemap, Open Graph and auth e-mails.
#   First deploy:   https://leonida-records.vercel.app
#   Own domain:     https://leonidarecords.com   (just change it here + redeploy)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Optional ────────────────────────────────────────────────────────────────

# Server-only secret key (Supabase → API Keys → "Secret key", sb_secret_...).
# ONLY needed to invite / delete users from /admin/settings/users.
# Without it everything else works; you create users in the Supabase dashboard.
# Never prefix it with NEXT_PUBLIC_. (Legacy name SUPABASE_SERVICE_ROLE_KEY also accepted.)
SUPABASE_SECRET_KEY=

# Set to "true" to enable Next.js image optimization (counts against Vercel's
# image-optimization quota). Off by default to stay inside the free tier.
IMAGE_OPTIMIZATION=false
